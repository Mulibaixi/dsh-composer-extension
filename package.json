{
  "name": "dsh-composer-extension",
  "version": "0.4.5",
  "private": true,
  "license": "MIT",
  "description": "Material submission and task coordination for translation and refinement workflows in DeepSeek Harness.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mulibaixi/dsh-composer-extension.git"
  },
  "homepage": "https://github.com/Mulibaixi/dsh-composer-extension#readme",
  "bugs": {
    "url": "https://github.com/Mulibaixi/dsh-composer-extension/issues"
  },
  "type": "module",
  "main": "./dist/host/index.js",
  "types": "./dist/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client.js"
    },
    "./contracts": {
      "types": "./dist/shared/contracts.d.ts",
      "default": "./dist/shared/contracts.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "patches",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs && node scripts/build-host-helper.mjs",
    "build:host-patches": "node scripts/build-host-patches.mjs",
    "prepack": "node scripts/check-package.mjs",
    "test:unit": "node --test --test-isolation=none tests/*.test.mjs",
    "test:native": "node --expose-internals --test --test-isolation=none scripts/*.integration.mjs",
    "check:commit": "node scripts/check-commit-message.mjs",
    "check:policy": "node scripts/check-staged-files.mjs",
    "hooks:install": "git config --local core.hooksPath .githooks"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-app-boot": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-registry": ">=0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-app-boot": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-group": "1.0.5",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.2",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
