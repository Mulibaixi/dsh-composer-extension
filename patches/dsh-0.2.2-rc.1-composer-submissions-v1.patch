index 0000000..a8764fc
--- /dev/null
+++ b/packages/client/ui-conversation/src/client/input/submissions.ts
@@ -0,0 +1,106 @@
+import { randomUUID } from '@deepseek-ai/dsh-util-crypto'
+import type { Context } from '@deepseek-ai/cordis'
+import type { SessionRequestId } from '@deepseek-ai/dsh-api-session-controller/types'
+import type {
+  ComposerSubmissionContribution, ComposerSubmissionGesture, ComposerSubmissionOutcome,
+  ComposerSubmissions, PreparedComposerContribution,
+} from '../contract/submissions.ts'
+
+interface Registration {
+  readonly contribution: ComposerSubmissionContribution
+  readonly active: Set<() => void>
+}
+
+/** Package-private transaction; the shell owns its native settlement. */
+export interface ComposerSubmissionPreparation {
+  readonly requestId: SessionRequestId
+  readonly signal: AbortSignal
+  prepare(signal: AbortSignal): Promise<void>
+  markDispatched(): void
+  finish(outcome: ComposerSubmissionOutcome): void
+}
+
+/** One root registry; independent plugins use only the public registration face. */
+export class ComposerSubmissionRegistry implements ComposerSubmissions {
+  get protocolVersion(): 1 { return 1 }
+  private readonly registrations = new Set<Registration>()
+
+  register(owner: Context, contribution: ComposerSubmissionContribution): () => void {
+    const entry: Registration = { contribution, active: new Set() }
+    this.registrations.add(entry)
+    const off = () => {
+      if (!this.registrations.delete(entry)) return
+      for (const cancel of [...entry.active]) cancel()
+    }
+    owner.effect(() => off, 'conversation submission contribution')
+    return off
+  }
+
+  /** Called only by the original Composer's synchronous submit transaction. */
+  freeze(input: Omit<ComposerSubmissionGesture, 'requestId'>): ComposerSubmissionPreparation {
+    const gesture: ComposerSubmissionGesture = Object.freeze({
+      ...input, requestId: randomUUID() as SessionRequestId,
+    })
+    const participants: { entry: Registration; prepared: PreparedComposerContribution }[] = []
+    const controller = new AbortController()
+    let freezeError: unknown
+    let hasFreezeError = false
+    let settled = false
+    let dispatched = false
+    const finish = (outcome: ComposerSubmissionOutcome) => {
+      if (settled) return
+      settled = true
+      const settlement = outcome === 'cancelled' && dispatched ? 'unknown' : outcome
+      if (settlement !== 'accepted') controller.abort(new Error(`Composer submission ${settlement}`))
+      for (const { entry, prepared } of participants) {
+        entry.active.delete(cancel)
+        try { prepared.finish(settlement) } catch { /* Cleanup cannot change native admission. */ }
+      }
+    }
+    const cancel = () => {
+      controller.abort(new Error('Composer submission contribution was disposed'))
+      finish(dispatched ? 'unknown' : 'cancelled')
+    }
+    for (const entry of this.registrations) {
+      try {
+        const prepared = entry.contribution.freeze(gesture)
+        if (prepared !== undefined) {
+          participants.push({ entry, prepared })
+          entry.active.add(cancel)
+        }
+      } catch (error) {
+        hasFreezeError = true
+        freezeError = error
+        // Keep native slash arbitration working; only an ordinary prompt applies the veto.
+        break
+      }
+    }
+    return {
+      requestId: gesture.requestId,
+      signal: controller.signal,
+      markDispatched: () => { dispatched = true },
+      prepare: async (signal) => {
+        if (hasFreezeError) throw freezeError
+        if (controller.signal.aborted) throw controller.signal.reason
+        if (signal.aborted) throw signal.reason
+        const abort = () => controller.abort(signal.reason)
+        signal.addEventListener('abort', abort, { once: true })
+        let rejectAbort: (reason: unknown) => void = () => {}
+        const cancelled = new Promise<never>((_resolve, reject) => { rejectAbort = reject })
+        const onAbort = () => rejectAbort(controller.signal.reason)
+        controller.signal.addEventListener('abort', onAbort, { once: true })
+        try {
+          await Promise.race([
+            Promise.all(participants.map(({ prepared }) => prepared.prepare(controller.signal))),
+            cancelled,
+          ])
+          if (controller.signal.aborted) throw controller.signal.reason
+        } finally {
+          signal.removeEventListener('abort', abort)
+          controller.signal.removeEventListener('abort', onAbort)
+        }
+      },
+      finish,
+    }
+  }
+}
