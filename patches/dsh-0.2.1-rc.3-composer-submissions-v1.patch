+import type { Context } from '@deepseek-ai/cordis'
+import type { SessionRequestId } from '@deepseek-ai/dsh-api-session-controller/types'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { InputSubmitMode } from './composer-submission.ts'
+
+/** Gesture facts fixed synchronously before command arbitration and reference serialization. */
+export interface ComposerSubmissionGesture {
+  readonly sessionId: SessionId
+  readonly requestId: SessionRequestId
+  readonly mode: InputSubmitMode
+  readonly timestamp: number
+  readonly source?: 'click' | 'enter'
+  /** The main Composer revision; independent business drafts have their own revisions. */
+  readonly draftRev: number
+}
+
+/** Host admission is distinct from a plugin's subsequent business acceptance. */
+export type ComposerSubmissionOutcome = 'accepted' | 'failed' | 'handled' | 'cancelled' | 'unknown'
+
+/** An immutable business snapshot is retained by this closure, never read again from the UI. */
+export interface PreparedComposerContribution {
+  /** Runs only after native arbitration selected an ordinary prompt. Reject to restore the native draft. */
+  prepare(signal: AbortSignal): Promise<void>
+  /** Exactly one settlement; consumed commands never run prepare. Cleanup must not throw. */
+  finish(outcome: ComposerSubmissionOutcome): void
+}
+
+export interface ComposerSubmissionContribution {
+  /** Synchronous: copy business state now; return undefined when the contribution does not apply. */
+  freeze(gesture: ComposerSubmissionGesture): PreparedComposerContribution | undefined
+}
+
+/** Public contribution face; root registration remains active while panels are hidden. */
+export interface ComposerSubmissions {
+  /** Read-only seam version; callers must match an explicitly supported contract. */
+  readonly protocolVersion?: 1
+  /** Owner context disposal unsubscribes and cancels every frozen, unadmitted contribution. */
+  register(owner: Context, contribution: ComposerSubmissionContribution): () => void
+}
